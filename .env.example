# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# ---------- Backend (Render) ----------

# OpenAI API key. OPENAI_API_KEY is the OpenAI SDK's default variable name,
# so the client picks it up automatically with no explicit wiring.
OPENAI_API_KEY=sk-proj-replace-me

# Vision model used for label extraction. Pinned by project decision.
OPENAI_MODEL=gpt-4.1-mini

# Comma-separated origins allowed to call the API (CORS).
# Add the Vercel production and preview domains before deploying.
ALLOWED_ORIGINS=http://localhost:5173

# Port the API listens on. Render injects its own PORT in deployment.
PORT=8000

# ---------- Frontend (Vercel) ----------

# Base URL of the backend API. Vite only exposes vars prefixed with VITE_
# to client code. Set this to the Render URL in the Vercel project settings.
VITE_API_BASE_URL=http://localhost:8000
